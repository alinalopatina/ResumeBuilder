<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Консольная утилита: экспорт/отчёты/демонстрации без графического интерфейса.
    Кроссплатформенная (Windows/Linux) — именно её позже упакуем в Docker-образ,
    т.к. WPF работает только на Windows с рабочим столом.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ResumeBuilder.Cli</RootNamespace>
    <AssemblyName>resumebuilder</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResumeBuilder.Infrastructure\ResumeBuilder.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="samples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    QuestPDF не поддерживает Windows ARM64 (нет нативной библиотеки win-arm64).
    Если сборка идёт на ARM64 (например, Windows в UTM/Parallels на Mac с Apple Silicon),
    приложение собирается как x64 — Windows 11 на ARM запускает его через эмуляцию.
    На обычных x64-компьютерах, в CI и в Docker это условие не срабатывает.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

</Project>
