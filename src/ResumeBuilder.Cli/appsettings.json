{
  "Localization": {
    "DefaultCulture": "ru-RU"
  },
  "Logging": {
    "SlowOperationThresholdMs": 1000
  },
  "Storage": {
    "DataFolder": "data"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "ResumeBuilder.Cli"
    },
    "WriteTo": [
      {
        // В консоль — только Information и выше, чтобы не мешать выводу команд.
        // Для отладки: RESUMEBUILDER_Serilog__WriteTo__0__Args__restrictedToMinimumLevel=Debug
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "standardErrorFromLevel": "Verbose",
          "outputTemplate": "  [{Level:u3}] {Message:lj} {CorrelationId}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cli-.log",
          "restrictedToMinimumLevel": "Warning",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cli-.json",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AuditLog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/audit-.log",
          "rollingInterval": "Month",
          "retainedFileCountLimit": 24,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss zzz} {Message:lj}{NewLine}"
        }
      }
    ]
  }
}
