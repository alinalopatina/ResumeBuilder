{
  // Внешняя конфигурация приложения. Изменения применяются без перекомпиляции.
  "Localization": {
    "DefaultCulture": "ru-RU"
  },

  "Logging": {
    // Операции дольше этого порога пишутся как Warning и попадают в основной файл журнала
    "SlowOperationThresholdMs": 1000
  },

  // ───── Основной журнал (Serilog) ─────
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Formatting.Compact" ],
    "MinimumLevel": {
      "Default": "Debug",
      // Иерархия логгеров: уровни для отдельных пространств имён (задание 1.3)
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "ResumeBuilder.Infrastructure.Serialization": "Information",
        "ResumeBuilder.Wpf": "Debug"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "ResumeBuilder.Wpf"
    },
    "WriteTo": [
      {
        // DEBUG и INFO — в консоль (видно при запуске из Visual Studio / dotnet run)
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {CorrelationId}{NewLine}{Exception}"
        }
      },
      {
        // WARNING и выше — дополнительно в текстовый файл; ротация по дням и по размеру 10 МБ, хранится 14 файлов
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/ResumeBuilder/logs/app-.log",
          "restrictedToMinimumLevel": "Warning",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({CorrelationId}) {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        // Структурированный журнал в JSON (задание 2.2): timestamp, level, message, ExecutionTimeMs, CorrelationId...
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/ResumeBuilder/logs/app-.json",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "restrictedToMinimumLevel": "Debug",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },

  // ───── Журнал аудита: отдельный файл и своя политика хранения (2 года, ротация раз в месяц) ─────
  "AuditLog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/ResumeBuilder/logs/audit-.log",
          "rollingInterval": "Month",
          "retainedFileCountLimit": 24,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss zzz} {Message:lj}{NewLine}"
        }
      }
    ]
  }
}
