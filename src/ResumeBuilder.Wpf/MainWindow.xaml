<Window x:Class="ResumeBuilder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:ResumeBuilder.Wpf.Properties"
        xmlns:views="clr-namespace:ResumeBuilder.Wpf.Views"
        Title="{Binding Title}" Icon="Resources/app.ico"
        Width="1100" Height="720" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource MainFont}" FontSize="13">
    <!-- Цвета и стили описаны в App.xaml (ресурсы приложения) -->
    <DockPanel>
        <!-- Меню -->
        <Menu DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="{x:Static p:Resources.Menu_File}">
                <MenuItem Header="{x:Static p:Resources.Menu_New}" Command="{Binding NewCommand}" />
                <MenuItem Header="{x:Static p:Resources.Menu_Sample}" Command="{Binding SampleCommand}" />
                <MenuItem Header="{x:Static p:Resources.Menu_Open}" Command="{Binding OpenCommand}" />
                <MenuItem Header="{x:Static p:Resources.Menu_Save}" Command="{Binding SaveCommand}" />
                <MenuItem Header="{x:Static p:Resources.Menu_CompareFormats}" Command="{Binding CompareFormatsCommand}" />
                <Separator />
                <MenuItem Header="{x:Static p:Resources.Menu_Print}" Command="{Binding PrintCommand}" />
                <MenuItem Header="{x:Static p:Resources.Menu_ReportPreview}" Command="{Binding ReportPreviewCommand}" />
                <Separator />
                <MenuItem Header="{x:Static p:Resources.Menu_Exit}" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="{x:Static p:Resources.Menu_Export}">
                <MenuItem Header="{x:Static p:Resources.Menu_ExportPdf}" Command="{Binding ExportPdfCommand}" />
                <MenuItem Header="{x:Static p:Resources.Menu_ExportWord}" Command="{Binding ExportWordCommand}" />
                <MenuItem Header="{x:Static p:Resources.Menu_ExportExcel}" Command="{Binding ExportExcelCommand}" />
                <MenuItem Header="{x:Static p:Resources.Menu_ExportReport}" Command="{Binding ExportReportCommand}" />
                <Separator />
                <MenuItem Header="{x:Static p:Resources.Menu_ImportWord}" Command="{Binding ImportWordCommand}" />
                <MenuItem Header="{x:Static p:Resources.Menu_ImportText}" Command="{Binding ImportTextCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static p:Resources.Menu_Language}">
                <MenuItem Header="Русский" Command="{Binding RussianCommand}" />
                <MenuItem Header="English" Command="{Binding EnglishCommand}" />
            </MenuItem>
        </Menu>

        <!-- Строка состояния -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Status}" />
        </StatusBar>

        <!-- Правая панель: две «карточки» — QR-код и экспорт, проверка данных -->
        <ScrollViewer DockPanel.Dock="Right" Width="290" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,16,16,16">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{x:Static p:Resources.Panel_Qr}" Style="{StaticResource CardTitle}" />
                        <Border HorizontalAlignment="Center" Padding="8" CornerRadius="8"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White">
                            <Image Source="{Binding QrImage}" Width="150" Height="150" />
                        </Border>
                        <Button Content="{x:Static p:Resources.Button_UpdateQr}" Command="{Binding UpdateQrCommand}" Margin="0,10,0,6" />

                        <CheckBox Content="{x:Static p:Resources.Check_IncludeQr}" IsChecked="{Binding IncludeQr}" />
                        <CheckBox Content="{x:Static p:Resources.Check_HideContacts}" IsChecked="{Binding HideContacts}" />
                        <Button Content="{x:Static p:Resources.Menu_ExportPdf}" Command="{Binding ExportPdfCommand}"
                                Style="{StaticResource AccentButton}" Margin="0,10,0,0" Padding="14,9" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static p:Resources.Panel_Errors}" Style="{StaticResource CardTitle}" />
                        <Button Content="{x:Static p:Resources.Button_Validate}" Command="{Binding ValidateCommand}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Errors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Каждая ошибка — в светло-красной плашке -->
                                    <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="8,6" Margin="0,3">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Вкладки. Каждая вкладка — отдельный UserControl из папки Views -->
        <TabControl Margin="16">
            <TabItem Header="{x:Static p:Resources.Tab_Personal}">
                <views:PersonalInfoView />
            </TabItem>
            <TabItem Header="{x:Static p:Resources.Tab_Experience}">
                <views:ExperienceView DataContext="{Binding Experience}" />
            </TabItem>
            <TabItem Header="{x:Static p:Resources.Tab_Education}">
                <views:EducationView DataContext="{Binding Education}" />
            </TabItem>
            <TabItem Header="{x:Static p:Resources.Tab_Skills}">
                <views:SkillsView DataContext="{Binding Skills}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
