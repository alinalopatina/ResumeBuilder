<Window x:Class="ResumeBuilder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ResumeBuilder.Wpf.Services"
        xmlns:vm="clr-namespace:ResumeBuilder.Wpf.ViewModels"
        Title="{Binding WindowTitle}"
        Icon="Resources/app.ico"
        Width="1200" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ValidateCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- ═════════════ Меню ═════════════ -->
        <Menu DockPanel.Dock="Top" Padding="2">
            <MenuItem Header="{loc:Tr Menu_File}">
                <MenuItem Header="{loc:Tr Menu_New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="{loc:Tr Menu_Sample}" Command="{Binding SampleCommand}" />
                <MenuItem Header="{loc:Tr Menu_Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_Save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="{loc:Tr Menu_SaveAs}" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_Print}" Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_Exit}" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="{loc:Tr Menu_Edit}">
                <MenuItem Header="{loc:Tr Menu_Undo}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{loc:Tr Menu_Normalize}" Command="{Binding NormalizeCommand}" />
                <MenuItem Header="{loc:Tr Menu_Validate}" Command="{Binding ValidateCommand}" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="{loc:Tr Menu_Export}">
                <MenuItem Header="{loc:Tr Menu_ExportPdf}" Command="{Binding ExportPdfCommand}" />
                <MenuItem Header="{loc:Tr Menu_ExportWord}" Command="{Binding ExportWordCommand}" />
                <MenuItem Header="{loc:Tr Menu_ExportExcel}" Command="{Binding ExportExcelCommand}" />
                <Separator />
                <MenuItem Header="{loc:Tr Menu_ExportReport}" Command="{Binding ExportReportCommand}" />
                <MenuItem Header="{loc:Tr Menu_ImportWord}" Command="{Binding ImportWordCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Tr Menu_Language}">
                <MenuItem Header="Русский" Command="{Binding SetLanguageCommand}" CommandParameter="ru-RU" />
                <MenuItem Header="English" Command="{Binding SetLanguageCommand}" CommandParameter="en-US" />
            </MenuItem>
        </Menu>

        <!-- ═════════════ Панель инструментов ═════════════ -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Content="{loc:Tr Menu_New}" Command="{Binding NewCommand}" />
                <Button Style="{StaticResource ToolButton}" Content="{loc:Tr Menu_Open}" Command="{Binding OpenCommand}" />
                <Button Style="{StaticResource ToolButton}" Content="{loc:Tr Menu_Save}" Command="{Binding SaveCommand}" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Content="{loc:Tr Menu_Undo}" Command="{Binding UndoCommand}" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Content="PDF" Command="{Binding ExportPdfCommand}" FontWeight="Bold" />
                <Button Style="{StaticResource ToolButton}" Content="Word" Command="{Binding ExportWordCommand}" />
                <Button Style="{StaticResource ToolButton}" Content="Excel" Command="{Binding ExportExcelCommand}" />
                <Button Style="{StaticResource ToolButton}" Content="{loc:Tr Menu_ExportReport}" Command="{Binding ExportReportCommand}" />
                <Button Style="{StaticResource ToolButton}" Content="{loc:Tr Menu_Print}" Command="{Binding PrintCommand}" />
            </ToolBar>
        </ToolBarTray>

        <!-- ═════════════ Строка состояния ═════════════ -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="320" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- ═════════════ Вкладки с разделами резюме ═════════════ -->
            <TabControl Grid.Column="0">

                <!-- Личные данные -->
                <TabItem Header="{loc:Tr Tab_Personal}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_FullName}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Resume.Personal.FullName}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_DesiredPosition}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Resume.Personal.DesiredPosition}" />

                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Email}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Resume.Personal.Email}" />

                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Phone}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Resume.Personal.Phone}"
                                     ToolTip="+375 (29) 123-45-67 / 8 029 1234567" />

                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_City}" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Resume.Personal.City}" />

                            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_BirthDate}" />
                            <DatePicker Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" Width="200"
                                        SelectedDate="{Binding Resume.Personal.BirthDate}" />

                            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Website}" />
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Resume.Personal.Website}"
                                     ToolTip="https://github.com/username" />

                            <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Salary}" />
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="140" Text="{Binding Resume.Personal.DesiredSalary, TargetNullValue=''}" />
                                <ComboBox Width="80" Margin="6,3,0,3" IsEditable="True"
                                          ItemsSource="{x:Static vm:Lookups.Currencies}"
                                          Text="{Binding Resume.Personal.SalaryCurrency}" />
                            </StackPanel>

                            <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Photo}" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Resume.Personal.PhotoPath}"
                                     ToolTip="C:\Users\...\photo.jpg" />

                            <Button Grid.Row="9" Grid.Column="1" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,4"
                                    Content="{loc:Tr Menu_Normalize}" Command="{Binding NormalizeCommand}" />
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- О себе -->
                <TabItem Header="{loc:Tr Section_Summary}">
                    <DockPanel Margin="10">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Hint_Summary}" Foreground="Gray" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                    </DockPanel>
                </TabItem>

                <!-- Опыт работы -->
                <TabItem Header="{loc:Tr Section_Experience}">
                    <DockPanel Margin="10">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Hint_Grid}" Foreground="Gray" TextWrapping="Wrap" />
                        <DataGrid ItemsSource="{Binding Experience}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Column_Company}" Binding="{Binding Company}" Width="2*" />
                                <DataGridTextColumn Header="{loc:Tr Column_Position}" Binding="{Binding Position}" Width="2*" />
                                <DataGridTextColumn Header="{loc:Tr Column_City}" Binding="{Binding City}" Width="*" />
                                <DataGridTemplateColumn Header="{loc:Tr Column_Start}" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Margin="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Tr Column_End}" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Margin="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Tr Column_Description}" Binding="{Binding Description}" Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Образование -->
                <TabItem Header="{loc:Tr Section_Education}">
                    <DockPanel Margin="10">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Hint_Grid}" Foreground="Gray" TextWrapping="Wrap" />
                        <DataGrid ItemsSource="{Binding Education}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Column_Institution}" Binding="{Binding Institution}" Width="3*" />
                                <DataGridTextColumn Header="{loc:Tr Column_Degree}" Binding="{Binding Degree}" Width="*" />
                                <DataGridTextColumn Header="{loc:Tr Column_Specialty}" Binding="{Binding Specialty}" Width="3*" />
                                <DataGridTextColumn Header="{loc:Tr Column_StartYear}" Binding="{Binding StartYear}" Width="90" />
                                <DataGridTextColumn Header="{loc:Tr Column_EndYear}" Binding="{Binding EndYear, TargetNullValue=''}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Навыки -->
                <TabItem Header="{loc:Tr Section_Skills}">
                    <DockPanel Margin="10">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Hint_Grid}" Foreground="Gray" TextWrapping="Wrap" />
                        <DataGrid ItemsSource="{Binding Skills}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Column_Skill}" Binding="{Binding Name}" Width="3*" />
                                <DataGridComboBoxColumn Header="{loc:Tr Column_Category}" Width="2*"
                                                        ItemsSource="{x:Static vm:Lookups.SkillCategories}"
                                                        SelectedItemBinding="{Binding Category}" />
                                <DataGridComboBoxColumn Header="{loc:Tr Column_Level}" Width="*"
                                                        ItemsSource="{x:Static vm:Lookups.SkillLevels}"
                                                        SelectedItemBinding="{Binding Level}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Языки -->
                <TabItem Header="{loc:Tr Section_Languages}">
                    <DockPanel Margin="10">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr Hint_Grid}" Foreground="Gray" TextWrapping="Wrap" />
                        <DataGrid ItemsSource="{Binding Languages}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Tr Column_Language}" Binding="{Binding Language}" Width="2*" />
                                <DataGridComboBoxColumn Header="{loc:Tr Column_Level}" Width="*"
                                                        ItemsSource="{x:Static vm:Lookups.LanguageLevels}"
                                                        SelectedItemBinding="{Binding Level}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Умная вставка (регулярные выражения) -->
                <TabItem Header="{loc:Tr Tab_SmartPaste}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="3" Text="{loc:Tr Hint_SmartPaste}" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <TextBox Grid.Row="1" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Text="{Binding SmartPasteText, UpdateSourceTrigger=PropertyChanged}" />

                        <DockPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr SmartPaste_Found}" FontWeight="SemiBold" />
                            <ListBox ItemsSource="{Binding ExtractedItems}" />
                        </DockPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6">
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Tr SmartPaste_Analyze}" Command="{Binding AnalyzeTextCommand}" />
                            <Button Style="{StaticResource ToolButton}" Content="{loc:Tr SmartPaste_Apply}" Command="{Binding ApplyExtractionCommand}" />
                        </StackPanel>

                        <DockPanel Grid.Row="3" Grid.ColumnSpan="3">
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Tr SmartPaste_RegexPreview}" FontWeight="SemiBold" />
                            <TextBox IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Background="#FAFAFA"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     Text="{Binding RegexPreview, Mode=OneWay}" />
                        </DockPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#EEEEEE" />

            <!-- ═════════════ Правая панель: экспорт, QR, проверка ═════════════ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6,0,0,0">
                    <GroupBox Header="{loc:Tr Panel_Export}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_Template}" />
                            <ComboBox ItemsSource="{x:Static vm:Lookups.Templates}" SelectedItem="{Binding Template}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_DocumentLanguage}" />
                            <ComboBox ItemsSource="{x:Static vm:Lookups.Cultures}" SelectedItem="{Binding DocumentCulture}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Field_QrMode}" />
                            <ComboBox ItemsSource="{x:Static vm:Lookups.QrModes}" SelectedItem="{Binding QrMode}" />

                            <CheckBox Margin="0,8,0,2" Content="{loc:Tr Field_IncludeQr}" IsChecked="{Binding IncludeQr}" />
                            <CheckBox Margin="0,2" Content="{loc:Tr Field_MaskContacts}" IsChecked="{Binding MaskContacts}" />

                            <Button Style="{StaticResource AccentButton}" Margin="0,10,0,0" Content="{loc:Tr Menu_ExportPdf}" Command="{Binding ExportPdfCommand}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{loc:Tr Panel_Qr}">
                        <StackPanel>
                            <Image Source="{Binding QrPreview}" Width="170" Height="170" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Center" Content="{loc:Tr Qr_Refresh}" Command="{Binding RefreshQrCommand}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{loc:Tr Panel_Validation}">
                        <StackPanel>
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Content="{loc:Tr Menu_Validate}" Command="{Binding ValidateCommand}" />
                            <ItemsControl ItemsSource="{Binding ValidationIssues}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="6,4" CornerRadius="3" Background="#FFF3F3">
                                            <StackPanel>
                                                <TextBlock x:Name="Msg" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" />
                                                <TextBlock Text="{Binding Field}" FontSize="10" Foreground="Gray" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                <Setter TargetName="Msg" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
