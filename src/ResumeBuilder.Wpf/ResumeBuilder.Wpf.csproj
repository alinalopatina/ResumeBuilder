<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ResumeBuilder</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <NeutralLanguage>ru</NeutralLanguage>
  </PropertyGroup>

  <!-- QuestPDF не работает на Windows ARM (например, Windows в UTM на Mac M1–M4),
       поэтому на таком компьютере программа собирается как x64 и запускается через эмуляцию -->
  <PropertyGroup Condition="'$(PROCESSOR_ARCHITECTURE)' == 'ARM64'">
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResumeBuilder.Core\ResumeBuilder.Core.csproj" />
    <!-- Вывод журнала в окно «Вывод» Visual Studio (у WPF-приложения нет консоли) -->
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app.png" />
    <!-- Файлы конфигурации копируются рядом с exe: их можно менять без перекомпиляции -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
