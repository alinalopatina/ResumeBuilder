<UserControl x:Class="ResumeBuilder.Wpf.Views.ExperienceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:ResumeBuilder.Wpf.Properties">
    <!-- DataContext = ListViewModel (задаётся в MainWindow.xaml) -->
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{x:Static p:Resources.Button_Add}" Command="{Binding AddCommand}" Style="{StaticResource AccentButton}" />
            <Button Content="{x:Static p:Resources.Button_Remove}" Command="{Binding RemoveCommand}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static p:Resources.Column_Company}" Binding="{Binding Company}" Width="2*" />
                <DataGridTextColumn Header="{x:Static p:Resources.Column_Position}" Binding="{Binding Position}" Width="2*" />
                <DataGridTemplateColumn Header="{x:Static p:Resources.Column_Start}" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static p:Resources.Column_End}" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static p:Resources.Column_Description}" Binding="{Binding Description}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
