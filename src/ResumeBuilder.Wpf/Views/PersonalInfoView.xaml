<UserControl x:Class="ResumeBuilder.Wpf.Views.PersonalInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:ResumeBuilder.Wpf.Properties">
    <!-- DataContext = MainViewModel (наследуется от окна) -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static p:Resources.Field_FullName}" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Personal.FullName}" />

        <TextBlock Grid.Row="1" Text="{x:Static p:Resources.Field_Position}" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Personal.Position}" />

        <TextBlock Grid.Row="2" Text="{x:Static p:Resources.Field_Email}" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Personal.Email}" />

        <TextBlock Grid.Row="3" Text="{x:Static p:Resources.Field_Phone}" />
        <DockPanel Grid.Row="3" Grid.Column="1">
            <Button DockPanel.Dock="Right" Margin="6,3,0,3" Padding="8,0"
                    Content="{x:Static p:Resources.Button_NormalizePhone}" Command="{Binding NormalizePhoneCommand}" />
            <TextBox Text="{Binding Personal.Phone}" />
        </DockPanel>

        <TextBlock Grid.Row="4" Text="{x:Static p:Resources.Field_City}" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Personal.City}" />

        <TextBlock Grid.Row="5" Text="{x:Static p:Resources.Field_BirthDate}" />
        <DatePicker Grid.Row="5" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,3"
                    SelectedDate="{Binding Personal.BirthDate}" />

        <TextBlock Grid.Row="6" Text="{x:Static p:Resources.Field_Website}" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Personal.Website}" />

        <TextBlock Grid.Row="7" Text="{x:Static p:Resources.Tab_About}" VerticalAlignment="Top" />
        <TextBox Grid.Row="7" Grid.Column="1" Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Text="{Binding About}" />
    </Grid>
</UserControl>
