<UserControl x:Class="ResumeBuilder.Wpf.Views.PersonalInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:ResumeBuilder.Wpf.Properties">
    <!-- DataContext = MainViewModel (наследуется от окна) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="12" MaxWidth="760" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static p:Resources.Field_FullName}" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Personal.FullName}" />

        <TextBlock Grid.Row="1" Text="{x:Static p:Resources.Field_Position}" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Personal.Position}" />

        <TextBlock Grid.Row="2" Text="{x:Static p:Resources.Field_Email}" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Personal.Email}" />

        <TextBlock Grid.Row="3" Text="{x:Static p:Resources.Field_Phone}" Style="{StaticResource FieldLabel}" />
        <DockPanel Grid.Row="3" Grid.Column="1">
            <Button DockPanel.Dock="Right" Margin="8,4,0,4" Padding="12,0"
                    Content="{x:Static p:Resources.Button_NormalizePhone}" Command="{Binding NormalizePhoneCommand}" />
            <TextBox Text="{Binding Personal.Phone}" />
        </DockPanel>

        <TextBlock Grid.Row="4" Text="{x:Static p:Resources.Field_City}" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Personal.City}" />

        <TextBlock Grid.Row="5" Text="{x:Static p:Resources.Field_BirthDate}" Style="{StaticResource FieldLabel}" />
        <DatePicker Grid.Row="5" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                    SelectedDate="{Binding Personal.BirthDate}" />

        <TextBlock Grid.Row="6" Text="{x:Static p:Resources.Field_Website}" Style="{StaticResource FieldLabel}" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Personal.Website}" />

        <TextBlock Grid.Row="7" Text="{x:Static p:Resources.Tab_About}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,10,12,0" />
        <TextBox Grid.Row="7" Grid.Column="1" Height="140" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Text="{Binding About}" />
    </Grid>
    </ScrollViewer>
</UserControl>
