<Window x:Class="ResumeBuilder.Wpf.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:ResumeBuilder.Wpf.Properties"
        Title="{x:Static p:Resources.Report_WindowTitle}"
        Width="760" Height="600" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static p:Resources.Menu_Print}" Command="{Binding PrintCommand}" />
            <Button Content="{x:Static p:Resources.Button_SaveTxt}" Command="{Binding SaveTxtCommand}" />
        </StackPanel>
        <!-- Моноширинный шрифт, чтобы столбцы текстовой таблицы были ровными -->
        <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
