<Window x:Class="ResumeBuilder.Wpf.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:ResumeBuilder.Wpf.Properties"
        Title="{x:Static p:Resources.Report_WindowTitle}"
        Width="780" Height="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource MainFont}" FontSize="13">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static p:Resources.Menu_Print}" Command="{Binding PrintCommand}" Style="{StaticResource AccentButton}" />
            <Button Content="{x:Static p:Resources.Button_SaveTxt}" Command="{Binding SaveTxtCommand}" Margin="0,4,0,4" />
        </StackPanel>
        <!-- Моноширинный шрифт, чтобы столбцы текстовой таблицы были ровными -->
        <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="13" Padding="12" VerticalContentAlignment="Top"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
