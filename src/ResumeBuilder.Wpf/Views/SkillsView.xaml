<UserControl x:Class="ResumeBuilder.Wpf.Views.SkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:ResumeBuilder.Wpf.Properties">
    <!-- DataContext = ListViewModel (задаётся в MainWindow.xaml) -->
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{x:Static p:Resources.Button_Add}" Command="{Binding AddCommand}" />
            <Button Content="{x:Static p:Resources.Button_Remove}" Command="{Binding RemoveCommand}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static p:Resources.Column_Skill}" Binding="{Binding Name}" Width="3*" />
                <DataGridTextColumn Header="{x:Static p:Resources.Column_Level}" Binding="{Binding Level}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
