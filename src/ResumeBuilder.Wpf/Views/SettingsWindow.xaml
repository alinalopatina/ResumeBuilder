<Window x:Class="ResumeBuilder.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:ResumeBuilder.Wpf.Properties"
        Title="{x:Static p:Resources.Settings_Title}"
        Width="640" Height="680" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource MainFont}" FontSize="13">
    <!-- DataContext = SettingsViewModel -->
    <DockPanel Margin="16">
        <!-- Кнопки внизу -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static p:Resources.Settings_Import}" Command="{Binding ImportCommand}" />
                <Button Content="{x:Static p:Resources.Settings_Export}" Command="{Binding ExportCommand}" />
                <Button Content="{x:Static p:Resources.Settings_Reset}" Command="{Binding ResetCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static p:Resources.Settings_Cancel}" Command="{Binding CancelCommand}" />
                <Button Content="{x:Static p:Resources.Settings_Save}" Command="{Binding SaveCommand}"
                        Style="{StaticResource AccentButton}" Margin="0,4,0,4" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Настройки -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Static p:Resources.Settings_Profile}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4" Padding="8,6"
                                  ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}" />

                        <TextBlock Grid.Row="1" Text="{x:Static p:Resources.Settings_Language}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="8,6"
                                  ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />

                        <TextBlock Grid.Row="2" Text="{x:Static p:Resources.Settings_ExportFolder}" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="2" Grid.Column="1">
                            <Button DockPanel.Dock="Right" Margin="8,4,0,4" Padding="12,0"
                                    Content="{x:Static p:Resources.Settings_Browse}" Command="{Binding BrowseCommand}" />
                            <TextBox Text="{Binding ExportFolder}" />
                        </DockPanel>

                        <TextBlock Grid.Row="3" Text="{x:Static p:Resources.Settings_QrSize}" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="3" Grid.Column="1">
                            <TextBlock DockPanel.Dock="Right" Width="30" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding QrPixelsPerModule}" />
                            <Slider Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Value="{Binding QrPixelsPerModule}" />
                        </DockPanel>

                        <TextBlock Grid.Row="4" Text="{x:Static p:Resources.Settings_Autosave}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                                 Text="{Binding AutosaveMinutes, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="5" Text="{x:Static p:Resources.Settings_Accent}" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Width="120" Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Width="28" Height="28" Margin="10,0,0,0" CornerRadius="6"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    Background="{Binding AccentPreview}" />
                        </StackPanel>

                        <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,8,0,0"
                                  Content="{x:Static p:Resources.Settings_IncludeQr}" IsChecked="{Binding IncludeQrByDefault}" />
                    </Grid>
                </Border>

                <!-- Ошибки проверки настроек -->
                <ItemsControl ItemsSource="{Binding Errors}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource DangerLightBrush}" CornerRadius="6" Padding="8,6" Margin="0,3">
                                <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Откуда берутся настройки -->
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static p:Resources.Settings_Sources}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Sources, Mode=OneWay}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
