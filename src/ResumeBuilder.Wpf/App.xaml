<Application x:Class="ResumeBuilder.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Ресурсы приложения: общие цвета и стили -->
        <SolidColorBrush x:Key="AccentBrush" Color="#1F4E79" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#D9E2F3" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
        <SolidColorBrush x:Key="WarningBrush" Color="#EF6C00" />

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,6,8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#424242" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="4,3" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style TargetType="Button" x:Key="AccentButton">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="True" />
            <Setter Property="CanUserDeleteRows" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6" />
        </Style>
    </Application.Resources>
</Application>
