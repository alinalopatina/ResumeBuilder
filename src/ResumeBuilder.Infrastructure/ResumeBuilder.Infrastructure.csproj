<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Инфраструктура: всё, что зависит от сторонних библиотек и файловых форматов.
    Ни одна из библиотек не требует установленного MS Office (Interop не используется),
    поэтому код работает и в Docker-контейнере на Linux.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ResumeBuilder.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResumeBuilder.Core\ResumeBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDF (лицензия Community — бесплатно для студентов и компаний с оборотом < 1 млн $) -->
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <!-- QR-код (MIT) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Excel (MIT) -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- Word / низкоуровневый Excel (MIT, официальная библиотека Microsoft) -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <!-- Журналирование -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <!-- Конфигурация и внедрение зависимостей -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ResumeBuilder.Tests" />
  </ItemGroup>

</Project>
