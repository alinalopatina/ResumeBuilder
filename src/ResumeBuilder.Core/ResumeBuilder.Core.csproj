<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Пользовательская библиотека классов (бизнес-логика).
    Не зависит ни от UI, ни от сторонних форматов: модели, валидация,
    регулярные выражения, локализация, агрегация данных для отчётов.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ResumeBuilder.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тестовый проект видит internal-члены -->
    <InternalsVisibleTo Include="ResumeBuilder.Tests" />
  </ItemGroup>

</Project>
